# ============================================================
# KOI Recall Backend — Environment Configuration
# Copy to .env.local and fill in the values for local development
# ============================================================

# Environment: local | preview | staging | production
APP_ENV=local
PORT=3002

# CORS — comma-separated list of allowed origins
# local dev: include both web (3000) and admin (3001)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Required for database-backed services ──
# Local:  postgresql://koi:koi_dev@localhost:5432/koi_recall
# Neon:   postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/koi_recall?sslmode=require
# Leave empty to run in skeleton mode (all endpoints return 501)
DATABASE_URL=

# ── Private Blob Storage (Vercel Blob) ──
# Must be a Vercel Blob read-write token. Leave empty for 501 on upload endpoints.
BLOB_READ_WRITE_TOKEN=
# Vercel Blob upload-completion callback URL. Leave empty in local dev.
BLOB_WEBHOOK_CALLBACK_URL=

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender domain in Resend
RESEND_FROM_EMAIL=
# Resend/Svix webhook signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=
# Recipient for the `pnpm email:test` smoke send.
# TEST_EMAIL_TO=

# ── Security ──
# Cron job secret — protects /internal/jobs/* endpoints
CRON_SECRET=
# AES-256-GCM encryption key for PII at rest (exactly 32 bytes, Base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# HMAC pepper for lookup hashes (at least 32 bytes, Base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HASH_PEPPER=
# Legacy admin API key (deprecated — use staff sessions instead)
ADMIN_API_KEY=
# Cross-instance rate limiting (Upstash Redis / Vercel KV). Without a configured
# pair the app falls back to a per-instance in-memory limiter, where the
# effective quota becomes instances × configured limit and resets on every cold
# start — on the brute-force surfaces (admin login, case-reference lookups) that
# means no real limit. Either naming works:
#   • a direct Upstash setup           -> UPSTASH_REDIS_REST_URL / _TOKEN
#   • Vercel's marketplace integration -> KV_REST_API_URL / KV_REST_API_TOKEN
#     (it still returns an Upstash REST URL, only the variable names are legacy)
# Note KV_REST_API_READ_ONLY_TOKEN cannot be used here — limiting writes counters.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Require external malware scan for uploaded documents
MALWARE_SCAN_REQUIRED=false
# Allow synthetic seed data (development only!)
ALLOW_SYNTHETIC_SEED=false

# ── RFC 9457 Problem Details ──
# Stable production domain for problem type URIs
PROBLEM_BASE_URL=http://localhost:3002

# ── Consumer web app ──
# Base URL used for consumer-facing links in transactional emails
# (e.g. the "provide information" claim link in the need_info email)
CONSUMER_WEB_BASE_URL=http://localhost:3000
# On-demand cache invalidation. Publishing a campaign version calls this so the
# web app stops serving the superseded notice immediately instead of waiting out
# its 60-second revalidate window. WEB_REVALIDATE_SECRET must match the web
# app's REVALIDATE_SECRET. Leave either unset to fall back to the time window.
# WEB_REVALIDATE_URL=https://koiimprtinc.com/api/revalidate
# WEB_REVALIDATE_SECRET=
