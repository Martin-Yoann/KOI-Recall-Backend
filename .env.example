APP_ENV=local
PORT=3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=
# Private Blob (Vercel Blob). Omit to leave upload authorization on the 501 stub.
BLOB_READ_WRITE_TOKEN=
# Route Vercel POSTs upload-completion callbacks to. Empty in local dev (Vercel
# cannot reach localhost); set to the public webhook URL in preview/production.
BLOB_WEBHOOK_CALLBACK_URL=
RESEND_API_KEY=
# Verified sender used by the outbox worker.
RESEND_FROM_EMAIL=
# Resend/Svix webhook signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# false records verified uploads as scan_status=not_run; true requires an
# external scanner to set scan_status=clean before Claim submission.
MALWARE_SCAN_REQUIRED=false
FIELD_ENCRYPTION_KEY=
HASH_PEPPER=
ALLOW_SYNTHETIC_SEED=false
