{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "buildCommand": "pnpm build",
  "builds": [{ "src": "api/index.ts", "use": "@vercel/node" }],
  "crons": [
    {
      "path": "/internal/jobs/outbox",
      "schedule": "0 3 * * *"
    }
  ]
}
