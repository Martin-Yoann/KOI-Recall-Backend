# esbuild's postinstall (install.js) is a redundant binary download fallback —
# the real binary is resolved at runtime from the @esbuild/<platform> optional
# dependencies. Skipping install scripts avoids a flaky multi-version race
# (esbuild@0.18/0.25/0.27/0.28 coexist via dev tooling) that crashes `pnpm install`
# on a cold build.
ignore-scripts=true
